# Питон приезжает с образом, а не берётся из системы: на Ubuntu 22.04 штатный —
# 3.10, а коду нужен минимум 3.12. Заодно окружение на сервере оказывается тем
# же, что на ноутбуке разработчика, с точностью до патч-версии.
FROM python:3.14-slim

# Байткод не пишем: файловая система контейнера смонтирована только на чтение,
# и .pyc рядом с исходниками положить всё равно некуда. Буферизацию вывода
# отключаем, иначе логи доезжают до docker logs пачками с опозданием
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Зависимости отдельным слоем и до копирования кода: requirements меняется раз
# в месяц, а код — по нескольку раз в день, и пересобирать ради этого колёса
# python-telegram-bot незачем
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py ./
COPY bot/ bot/
COPY core/ core/

# Карточки кладутся в образ вместе с кодом: тогда серверу не нужен ни git, ни
# ключ к приватному репозиторию, а образ с тегом коммита воспроизводится целиком.
# Каталог собирается перед сборкой — `make image` или checkout в CI
COPY content/ content/

# Описание запуска кладётся в образ только для сверки: выкладка сравнивает его
# с тем, что лежит на машине, и сообщает о расхождении. Применять его оттуда
# нельзя — переписывать compose.yaml выкладке намеренно не позволено
COPY compose.yaml ./

# Боту не нужен root: он не слушает портов и пишет только в /data
RUN useradd --system --create-home --uid 1000 wolfgang
USER wolfgang

CMD ["python", "main.py"]
