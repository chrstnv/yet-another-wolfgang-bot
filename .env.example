# Скопируйте в .env и заполните. Настоящий .env в гит не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Путь к репозиторию с карточками и аудио — он отдельный и приватный
CONTENT_PATH=../yet-another-wolfgang-content

# Файл базы с ответами и рекордами. Создастся сам при первом запуске
DB_PATH=bot.db

# Куда tools.add_card заливает аудио, чтобы получить file_id.
# Для запуска бота не нужен, нужен только при добавлении карточек
ADMIN_CHAT_ID=

# Файл с незавершёнными квизами. По умолчанию state.pickle рядом с кодом
STATE_PATH=state.pickle

# Куда бот отмечается, что опрос жив. Пусто — отметки не ведутся;
# в контейнере это /data/heartbeat, и по нему работает healthcheck
HEARTBEAT_PATH=

# Сколько раз пробовать достучаться до Телеграма и сколько ждать между
# попытками. Значения по умолчанию рассчитаны на здоровый канал
TELEGRAM_ATTEMPTS=5
TELEGRAM_PAUSE=0.2

# Если до api.telegram.org не достучаться напрямую — два способа обойти.
# Прокси на самой машине (socks5://127.0.0.1:1080 или http://...): в обход
# уходит только трафик бота, маршруты не трогаются
TELEGRAM_PROXY=

# Либо релей — чужой адрес вместо api.telegram.org.
# Пусто — бот ходит в Телеграм сам
TELEGRAM_BASE_URL=
